# Copy to .env (gitignored) and fill in. Never commit the real token.

# Bot token from the Discord developer portal: Applications > your app > Bot > Reset Token.
DISCORD_BOT_TOKEN=

# Guilds this server may act on, comma-separated. The first is the default.
# Right-click the server icon with Developer Mode on > Copy Server ID.
DISCORD_GUILD_IDS=

# true refuses every write. Useful for a first look at a server.
DISCORD_READ_ONLY=false
